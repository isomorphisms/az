#!/usr/bin/env ysh

# Paid live smoke for Alibaba Model Studio Responses API.
# qwen3-coder-next is not listed among the models with full Responses-agent
# features, so this proves only basic text compatibility if it passes.
# This script is intentionally not part of make test.

set -eu
set -o pipefail

script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_directory=$(CDPATH= cd -- "$script_directory/.." && pwd)
qwen_alibaba="$repository_directory/bin/qwen_alibaba"

: "${QWEN_MODEL:=qwen3-coder-next}"
: "${QWEN_BASE_URL:=https://dashscope-intl.aliyuncs.com/compatible-mode/v1}"
export QWEN_MODEL QWEN_BASE_URL
sentinel='AZ_QWEN_RESPONSES_OK'

command -v jq >/dev/null 2>&1 || {
  printf 'FAIL\tmissing_dependency\tjq\n' >&2
  exit 127
}

request=$(jq -cn   --arg model "$QWEN_MODEL"   --arg sentinel "$sentinel" '
    {
      model: $model,
      input: ("Reply with the exact token " + $sentinel + " and nothing else.")
    }
  ')

response=$(printf '%s\n' "$request" | ysh "$qwen_alibaba" response -)

returned_model=$(printf '%s' "$response" | jq -r '.model // ""')
content=$(printf '%s' "$response" |
  jq -r '[.output[]? | select(.type == "message") | .content[]? |
           select(.type == "output_text") | .text] | join("")')
input_tokens=$(printf '%s' "$response" | jq -r '.usage.input_tokens // ""')
output_tokens=$(printf '%s' "$response" | jq -r '.usage.output_tokens // ""')
response_id=$(printf '%s' "$response" | jq -r '.id // ""')
status=$(printf '%s' "$response" | jq -r '.status // ""')

if test "$returned_model" != "$QWEN_MODEL"; then
  printf 'FAIL\tresponses\tmodel_mismatch\n' >&2
  printf 'model_requested\t%s\n' "$QWEN_MODEL" >&2
  printf 'model_returned\t%s\n' "$returned_model" >&2
  exit 1
fi

if test "$status" != 'completed'; then
  printf 'FAIL\tresponses\tstatus_%s\n' "$status" >&2
  exit 1
fi

case "$input_tokens:$output_tokens" in
  *[!0-9:]*|:|:*|*:)
    printf 'FAIL\tresponses\tmissing_usage\n' >&2
    exit 1
    ;;
esac

if ! printf '%s\n' "$content" | grep -F "$sentinel" >/dev/null; then
  printf 'FAIL\tresponses\tmissing_sentinel\n' >&2
  printf 'model_requested\t%s\n' "$QWEN_MODEL" >&2
  printf 'model_returned\t%s\n' "$returned_model" >&2
  printf 'response_id\t%s\n' "$response_id" >&2
  printf 'status\t%s\n' "$status" >&2
  printf 'assistant_text\t%s\n' "$content" >&2
  exit 1
fi

printf 'PASS\tresponses_basic_text\n'
printf 'base_url\t%s\n' "$QWEN_BASE_URL"
printf 'model_requested\t%s\n' "$QWEN_MODEL"
printf 'model_returned\t%s\n' "$returned_model"
printf 'response_id\t%s\n' "$response_id"
printf 'status\t%s\n' "$status"
printf 'input_tokens\t%s\n' "$input_tokens"
printf 'output_tokens\t%s\n' "$output_tokens"
printf 'sentinel\t%s\n' "$sentinel"
