// Fieldmouse Wayback CDX checkpoint. No API key or custom headers are needed,
// so this is a useful current ICU GET watchpoint.

var command ← arguments(1);
var target ← arguments(2);

if (command = "replay") {
  console.log("https://web.archive.org/web/" + target + "id_/" + arguments(3));
} else {
  var from_date ← arguments(3);
  var to_date ← arguments(4);
  var match_type ← "exact";
  if (command = "domain") {
    match_type ← "domain";
  }

  var url ← "https://web.archive.org/cdx/search/cdx?url=" + percentEncode(target) +
    "&matchType=" + match_type +
    "&from=" + percentEncode(from_date) +
    "&to=" + percentEncode(to_date) +
    "&output=json&fl=timestamp,original,statuscode,mimetype,digest" +
    "&filter=statuscode:200&filter=mimetype:text/html&collapse=digest&gzip=false";

  if (command = "url" || command = "domain") {
    console.log(url);
  } else {
    if (command = "search") {
      var icu ← environmentDefault("ICU", "icu");
      run(icu, ["get", url]);
    } else {
      console.log("usage: wayback {url URL FROM TO | domain DOMAIN FROM TO | search URL FROM TO | replay TIMESTAMP URL}");
    }
  }
}
