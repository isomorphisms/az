// Fieldmouse Guardian checkpoint. Deliberately targets arguments, environment,
// percentEncode and process execution. ICU is the HTTP transport.

var command ← arguments(1);
var operand ← arguments(2);
var key ← environment("GUARDIAN_API_KEY");
var icu ← environmentDefault("ICU", "icu");

if (command = "url") {
  var url ← "https://content.guardianapis.com/search?q=" + percentEncode(operand) + "&order-by=oldest&api-key=" + percentEncode(key);
  console.log(url);
} else {
  if (command = "search") {
    var url ← "https://content.guardianapis.com/search?q=" + percentEncode(operand) + "&order-by=oldest&api-key=" + percentEncode(key);
    run(icu, ["get", url]);
  } else {
    console.log("usage: guardian {url QUERY | search QUERY | tags QUERY | sections QUERY | editions QUERY | item ID}");
  }
}
