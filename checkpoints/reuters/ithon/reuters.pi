#!/usr/bin/env ithon

import json
import os
import sys
from pathlib import Path


USAGE ∈ str ← "usage: reuters {endpoint | body QUERY_FILE | live QUERY_FILE}"


def endpoint() → str:
    value ∈ str ← os.environ.get("REUTERS_GRAPHQL_URL", "")
    if value == "":
        raise RuntimeError("reuters: missing REUTERS_GRAPHQL_URL")
    return value


def query_text(path_text ∈ str) → str:
    path ∈ Path ← Path(path_text)
    return path.read_text("utf-8")


def request_body(query ∈ str) → str:
    return json.dumps({"query": query}, separators=(",", ":"))


def live(path_text ∈ str) → int:
    url ∈ str ← endpoint()
    query ∈ str ← query_text(path_text)
    body ∈ str ← request_body(query)

    # Reuters' customer auth/header contract is supplied with a licensed
    # integration, not in the public product page. Do not invent it and do not
    # bypass ICU with requests/urllib. This remains an explicit checkpoint.
    if len(url) > 0 and len(body) > 0:
        sys.stderr.write("SKIP\treuters live: licensed headers + ICU custom request headers\n")
    return 3


def main() → int:
    arguments ∈ list[str] ← sys.argv

    if len(arguments) == 2 and arguments[1] == "endpoint":
        sys.stdout.write(endpoint() + "\n")
        return 0
    if len(arguments) == 3 and arguments[1] == "body":
        sys.stdout.write(request_body(query_text(arguments[2])) + "\n")
        return 0
    if len(arguments) == 3 and arguments[1] == "live":
        return live(arguments[2])

    sys.stderr.write(USAGE + "\n")
    return 2


raise SystemExit(main())
