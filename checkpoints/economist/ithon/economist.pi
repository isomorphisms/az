#!/usr/bin/env ithon

import os
import sys
import urllib.parse


BASE ∈ str ← "https://api.economist.com/eco/content/all/b2b-content-api"
USAGE ∈ str ← "usage: economist {articles FROM TO | article ID | sections | tags | brief | login-body | live ...}"


def encode(text ∈ str) → str:
    return urllib.parse.quote(text, "")


def articles_url(from_date ∈ str, to_date ∈ str) → str:
    return BASE + "/v1/articles?start_date=" + encode(from_date) + "&end_date=" + encode(to_date)


def live_blocked() → int:
    # Deliberately do not use urllib for the request. Economist content needs a
    # Bearer header; login needs Content-Type: application/json. Current ICU has
    # no caller-supplied header surface, so this remains a concrete ICU watchpoint.
    sys.stderr.write("SKIP\teconomist live: ICU custom request headers\n")
    return 3


def main() → int:
    arguments ∈ list[str] ← sys.argv

    if len(arguments) == 4 and arguments[1] == "articles":
        sys.stdout.write(articles_url(arguments[2], arguments[3]) + "\n")
        return 0
    if len(arguments) == 3 and arguments[1] == "article":
        sys.stdout.write(BASE + "/v1/articles/" + arguments[2] + "\n")
        return 0
    if len(arguments) == 2 and arguments[1] == "sections":
        sys.stdout.write(BASE + "/v1/sections\n")
        return 0
    if len(arguments) == 2 and arguments[1] == "tags":
        sys.stdout.write(BASE + "/v1/tags\n")
        return 0
    if len(arguments) == 2 and arguments[1] == "brief":
        sys.stdout.write(BASE + "/v1/the-world-in-brief\n")
        return 0
    if len(arguments) == 2 and arguments[1] == "login-body":
        client_id ∈ str ← os.environ.get("ECONOMIST_CLIENT_ID", "")
        client_secret ∈ str ← os.environ.get("ECONOMIST_CLIENT_SECRET", "")
        if client_id == "" or client_secret == "":
            raise RuntimeError("economist: missing credentials")
        sys.stdout.write("{\"client_id\":\"" + client_id + "\",\"client_secret\":\"" + client_secret + "\"}\n")
        return 0
    if len(arguments) >= 2 and arguments[1] == "live":
        return live_blocked()

    sys.stderr.write(USAGE + "\n")
    return 2


raise SystemExit(main())
