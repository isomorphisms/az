# Copy to ~/.config/az/qwen-secret and chmod 600.
# Do not commit the real key.
DASHSCOPE_API_KEY=

# The default is the Singapore international pay-as-you-go endpoint:
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#
# A workspace-specific endpoint is preferred once the workspace ID is known:
# QWEN_BASE_URL=https://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
#
# The adapter defaults to the full coding model selected for this work:
# QWEN_MODEL=qwen3-coder-next
