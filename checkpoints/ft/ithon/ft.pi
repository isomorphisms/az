#!/usr/bin/env ithon

import json
import os
import sys
import urllib.parse


SEARCH_ENDPOINT ∈ str ← "https://api.ft.com/content/search/v1"
USAGE ∈ str ← "usage: ft {search-body QUERY | content UUID | notifications SINCE | live-search QUERY}"


def encode(text ∈ str) → str:
    return urllib.parse.quote(text, "")


def search_body(query ∈ str) → str:
    body ∈ dict[str, object] ← {
        "queryString": query,
        "resultContext": {
            "aspects": ["title", "lifecycle", "location", "summary", "editorial"],
            "sortOrder": "ASC",
            "sortField": "initialPublishDateTime",
        },
    }
    return json.dumps(body, separators=(",", ":"))


def live_search(query ∈ str) → int:
    api_key ∈ str ← os.environ.get("FT_API_KEY", "")
    if api_key = "":
        raise RuntimeError("ft: missing FT_API_KEY")

    # FT needs X-Api-Key plus Content-Type on the POST. Do not route around the
    # current ICU header gap with urllib/requests merely to make this green.
    sys.stderr.write("SKIP\tft live-search: ICU custom request headers\n")
    return 3


def main() → int:
    arguments ∈ list[str] ← sys.argv

    if len(arguments) = 3 and arguments[1] = "search-body":
        sys.stdout.write(search_body(arguments[2]) + "\n")
        return 0
    if len(arguments) = 3 and arguments[1] = "content":
        sys.stdout.write("https://api.ft.com/content/" + arguments[2] + "\n")
        return 0
    if len(arguments) = 3 and arguments[1] = "notifications":
        sys.stdout.write("https://api.ft.com/content/notifications?since=" + encode(arguments[2]) + "\n")
        return 0
    if len(arguments) = 3 and arguments[1] = "live-search":
        return live_search(arguments[2])

    sys.stderr.write(USAGE + "\n")
    return 2


raise SystemExit(main())
