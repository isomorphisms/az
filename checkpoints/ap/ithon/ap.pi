#!/usr/bin/env ithon

import os
import sys
import urllib.parse


BASE ∈ str ← "https://api.ap.org/media/v"
USAGE ∈ str ← "usage: ap {search-url QUERY | item ID | feed | rss | rss-id ID | ondemand | live-choice | account | followed-topics | plans | live-search QUERY}"


def encode(text ∈ str) → str:
    return urllib.parse.quote(text, "")


def search_url(query ∈ str) → str:
    return BASE + "/content/search?q=" + encode(query) + "&page_size=25"


def live_search(query ∈ str) → int:
    api_key ∈ str ← os.environ.get("AP_API_KEY", "")
    if api_key == "":
        raise RuntimeError("ap: missing AP_API_KEY")

    # AP requires x-api-key. Use the absence of ICU custom request headers as
    # the checkpoint instead of replacing ICU with urllib/requests.
    sys.stderr.write("SKIP\tap live-search: ICU custom request headers\n")
    return 3


def main() → int:
    arguments ∈ list[str] ← sys.argv

    if len(arguments) == 3 and arguments[1] == "search-url":
        sys.stdout.write(search_url(arguments[2]) + "\n")
        return 0
    if len(arguments) == 3 and arguments[1] == "item":
        sys.stdout.write(BASE + "/content/" + arguments[2] + "\n")
        return 0
    if len(arguments) == 2 and arguments[1] == "feed":
        sys.stdout.write(BASE + "/content/feed\n")
        return 0
    if len(arguments) == 2 and arguments[1] == "rss":
        sys.stdout.write(BASE + "/content/rss\n")
        return 0
    if len(arguments) == 3 and arguments[1] == "rss-id":
        sys.stdout.write(BASE + "/content/rss/" + arguments[2] + "\n")
        return 0
    if len(arguments) == 2 and arguments[1] == "ondemand":
        sys.stdout.write(BASE + "/content/ondemand\n")
        return 0
    if len(arguments) == 2 and arguments[1] == "live-choice":
        sys.stdout.write(BASE + "/content/live-choice-events\n")
        return 0
    if len(arguments) == 2 and arguments[1] == "account":
        sys.stdout.write(BASE + "/account\n")
        return 0
    if len(arguments) == 2 and arguments[1] == "followed-topics":
        sys.stdout.write(BASE + "/account/followedtopics\n")
        return 0
    if len(arguments) == 2 and arguments[1] == "plans":
        sys.stdout.write(BASE + "/account/plans\n")
        return 0
    if len(arguments) == 3 and arguments[1] == "live-search":
        return live_search(arguments[2])

    sys.stderr.write(USAGE + "\n")
    return 2


raise SystemExit(main())
